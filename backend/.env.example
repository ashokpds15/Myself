# Backend Configuration

# Server Port
PORT=5000

# Gmail Configuration
# Get your Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Admin API Key (for sending notifications and viewing subscribers)
# Generate a strong random string for this
ADMIN_API_KEY=replace_with_a_long_random_secret

# Blogger API (used by the backend to serve public blog content)
BLOGGER_API_KEY=your_blogger_api_key
BLOGGER_BLOG_ID=3800019340026834324
UNSUBSCRIBE_SECRET=replace_with_another_long_random_secret
PUBLIC_API_URL=http://localhost:5000
